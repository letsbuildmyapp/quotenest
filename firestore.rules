rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public can create a lead from the quiz; only authenticated admins can read/update/delete.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'estimate', 'answers'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
